// a06 · 流程控制
// 演示：if/else if/else、switch（无 case/break、多值匹配、default）、while、do-while、break/continue
// 规范依据：reference/grammer/control-flow.md

// --- if / else if / else ---
number temperature = 23;
if (temperature > 30) {
    print("热");
} else if (temperature > 15) {
    print("舒适");
} else {
    print("冷");
}

// --- switch：值直接跟代码块，无需 case/break，无 fallthrough ---
number day = 6;
switch (day) {
    1, 2, 3, 4, 5 {
        print("工作日");
    }
    6, 7 {
        print("周末");
    }
    default {
        print("非法日期");
    }
}

// switch 也支持字符串匹配
string lang = "collie";
switch (lang) {
    "rust" { print("systems"); }
    "collie" { print("shepherd"); }
    default { print("unknown"); }
}

// --- while ---
number i = 0;
while (i < 3) {
    print(@"while 第 {i} 次");
    i += 1;
}

// --- do-while：先执行一次再判断 ---
number j = 10;
do {
    print(@"do-while 至少执行一次（j = {j}）");
    j += 1;
} while (j < 3);

// --- break / continue ---
number sum = 0;
number k = 0;
while (true) {
    k += 1;
    if (k % 2 == 0) {
        continue;        // 跳过偶数
    }
    if (k > 9) {
        break;           // 超过 9 退出
    }
    sum += k;            // 1+3+5+7+9
}
print(@"奇数和 = {sum}");
