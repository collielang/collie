// b03 · 二分查找 —— 有序数组查找 + 插入点定位 + 边界覆盖
// 迭代版与递归版各一，验证结果一致。
// 陷阱：语义分析将 arr[mid] == target 判为 Incomparable（元素静态类型非 number），
//       必须先赋给 number 变量再比较。

function binarySearch(arr array, target number) number {
    number lo = 0;
    number hi = len(arr) - 1;
    while (lo <= hi) {
        number mid = ((lo + hi) / 2).integerPart();
        number midVal = arr[mid];
        if (midVal == target) {
            return mid;
        } else if (midVal < target) {
            lo = mid + 1;
        } else {
            hi = mid - 1;
        }
    }
    return -1;                        // 未找到
}

function binarySearchRec(arr array, target number, lo number, hi number) number {
    if (lo > hi) {
        return -1;
    }
    number mid = ((lo + hi) / 2).integerPart();
    number midVal = arr[mid];
    if (midVal == target) {
        return mid;
    }
    if (midVal < target) {
        return binarySearchRec(arr, target, mid + 1, hi);
    }
    return binarySearchRec(arr, target, lo, mid - 1);
}

// lowerBound：第一个 >= target 的下标（可作插入点）
function lowerBound(arr array, target number) number {
    number lo = 0;
    number hi = len(arr);
    while (lo < hi) {
        number mid = ((lo + hi) / 2).integerPart();
        if (arr[mid] < target) {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    return lo;
}

array sorted = [1, 3, 5, 7, 9, 11, 13];

// 命中：头 / 中 / 尾
print(binarySearch(sorted, 1));       // 0
print(binarySearch(sorted, 7));       // 3
print(binarySearch(sorted, 13));      // 6

// 未命中
print(binarySearch(sorted, 8));       // -1
print(binarySearch(sorted, -5));      // -1
print(binarySearch(sorted, 99));      // -1

// 递归版与迭代版一致
print(binarySearchRec(sorted, 9, 0, len(sorted) - 1));   // 4
print(binarySearchRec(sorted, 8, 0, len(sorted) - 1));   // -1

// 插入点
print(lowerBound(sorted, 6));         // 3（插到 7 前）
print(lowerBound(sorted, 0));         // 0（最前）
print(lowerBound(sorted, 14));        // 7（最后）

// 边界：空数组
array empty = [];
print(binarySearch(empty, 1));        // -1
