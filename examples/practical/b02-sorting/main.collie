// b02 · 排序算法 —— 冒泡排序 + 选择排序 + 已排序判定
// 注意：数组是引用语义，排序会就地修改原数组；arr[i] += 不支持，用 arr[i] = arr[i] + x。

function bubbleSort(arr array) array {
    number n = len(arr);
    for (number i = 0; i < n - 1; i = i + 1) {
        for (number j = 0; j < n - 1 - i; j = j + 1) {
            if (arr[j] > arr[j + 1]) {
                number tmp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = tmp;
            }
        }
    }
    return arr;
}

function selectionSort(arr array) array {
    number n = len(arr);
    for (number i = 0; i < n - 1; i = i + 1) {
        number minIdx = i;
        for (number j = i + 1; j < n; j = j + 1) {
            if (arr[j] < arr[minIdx]) {
                minIdx = j;
            }
        }
        if (minIdx != i) {
            number tmp = arr[i];
            arr[i] = arr[minIdx];
            arr[minIdx] = tmp;
        }
    }
    return arr;
}

function isSorted(arr array) bool {
    for (number i = 1; i < len(arr); i = i + 1) {
        if (arr[i - 1] > arr[i]) {
            return false;
        }
    }
    return true;
}

// ---- 冒泡排序 ----
array data1 = [5, 2, 9, 1, 7, 3];
print(@"排序前：{data1}");
bubbleSort(data1);                    // 引用语义：原数组被就地排序
print(@"冒泡后：{data1}");
print(isSorted(data1));

// ---- 选择排序（含重复元素与负数） ----
array data2 = [4, -1, 4, 0, -7, 2];
selectionSort(data2);
print(@"选择后：{data2}");
print(isSorted(data2));

// ---- 边界：空数组与单元素 ----
array empty = [];
bubbleSort(empty);
print(isSorted(empty));

array single = [42];
selectionSort(single);
print(@"{single}");
