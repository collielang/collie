// t153 S100 差分用例：动态承载值（Dyn）作索引接收者——嵌套容器索引 `a[i][j]` 读写
// Dyn 来源（动态域元素读 / kind 7 元素 / object 动态槽 / 动态 tuple 索引与 get /
// 闭包捕获）按运行期 tag 分派：3=串 UTF-8 码点索引、4/7=数组按内层 kind 读
function f(a array) none { print("A:", a[0][1], a[1][0], a[-1][-1]); }
function g(a array) none { print("B:", a[0][0], a[1][2], a[0][-1]); }
function s(a array) none { print("C:", a[1][1], a[1][-1], a[1][3][0], a[1].length); }
function h(a array) none { print("D:", a[0][0][1], a[0][1][0]); }
function mix(a array) none { print("E:", a[0][1], a[1][0]); }
function carrier(a array) none { object v = a[0]; print("F:", v[1], v.length); }
function loop(a array) none {
    integer i = 0;
    while (i < 2) { print("G", i, ":", a[i][i], a[i].length); i = i + 1; }
}
function viaIndex(a array, idx array) none { print("H:", a[0][idx[0]], a[1][idx[1]]); }
function nested(a array) none { print("I:", a[0][0][1]); }
function w(a array) none {
    a[0][0] = 9;
    a[1][1] = 8;
    print("J:", a[0], a[1], a);
}
function w7(a array) none {
    a[0][1] = "two";
    a[0][0] = 1.5;
    print("K:", a[0], a[0][1], a[0][0]);
}
function wi(a array, idx array) none {
    a[0][idx[1]] = 42;
    print("L:", a[0]);
}
function wc(a array) none {
    object v = a[0];
    v[0] = 5;
    print("M:", v, a[0]);
}
function wn(a array) none {
    a[0][0][1] = 77;
    print("N:", a[0]);
}
class Grid {
    public array rows = [[1, 2], [3, 4]];
    public function show() none { print("O:", this.rows[0][1], this.rows[1][0]); }
    public function poke(i integer, j integer) none {
        this.rows[i][j] = 0;
    }
}
function outer(a array) none {
    object v = a[0];
    function reader() none { print("Q:", v[1], v.length); }
    reader();
    v = a[1];
    reader();
}
function sw(a array) none {
    object tmp = a[0][0];
    a[0][0] = a[0][1];
    a[0][1] = tmp;
    print("R:", a[0]);
}
function viaTuple(a array) none {
    Tuple t = (a[0], a[1]);
    integer i = 1;
    print("S:", t[i][0]);
}
f([[1, 2], [3, 4]]);
g([[true], [1, 2, 3]]);
s([1, "hello", true]);
h([[[1, 2], [3]], [[4]]]);
mix([[1, "x", true], [false, 2]]);
carrier(["abcd", "e"]);
loop([[7, 8, 9], [1, 2, 3]]);
viaIndex([[10, 20], [30, 40]], [1, 0]);
nested([[[1, 2]]]);
w([[1, 2], [3, 4]]);
w7([[1, true]]);
wi([[1, 2], [3]], [0, 0]);
wc([[1, 2]]);
wn([[[1, 2]]]);
Grid gd = new Grid();
gd.show();
gd.poke(1, 1);
print("P:", gd.rows);
outer([[7, 8, 9], ["ab", "cde"]]);
sw([[1, 2], [3]]);
viaTuple([[5, 6], [7]]);
