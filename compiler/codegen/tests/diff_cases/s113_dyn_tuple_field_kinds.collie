// t163 S110 差分用例：动态 tuple 各标量位字段经命名字段访问读出后的消费面
// 读出恒 Dyn，算术/比较/拼接/类型化槽/串方法/number 方法/tribool 方法全走既有 tag 分派
function mixed(flag bool) Tuple {
    return flag ? (i: 7, d: 2.5, s: " pad ", b: true, t: unset) : (z: 0);
}
Tuple m = mixed(true);
print("1", m.i);
print("2", m.d);
print("3", m.s);
print("4", m.b);
print("5", m.t);
print("6", m.i + m.d);
print("7", m.i * 2);
print("8", m.i > 3);
print("9", m.i == m.i);
print("10", m.s.trim());
print("11", m.s.length);
print("12", m.d.isDecimal());
print("13", m.i.isInteger());
print("14", m.t.isUnset());
print("15", m.b.toString());
print("16", m.s.toNumber());
integer i = m.i;
decimal d = m.d;
string s = m.s;
bool b = m.b;
tribool t = m.t;
print("17", i);
print("18", d);
print("19", s);
print("20", b);
print("21", t);
number n = m.d;
print("22", n + 1);
