// t130 S83 差分用例：if/while/for/switch 各分支块内类声明（class-in-block）——
// 仅声明所在块内（含嵌套）可实例化；跨块/作用域外 new 保守拒编（块是否执行属
// 运行期事实，静态无从判定）。每类均含方法，验证块内声明类的方法生成。

if (true) {
    class IC {
        public number v = 1;
        public function getv() number { return this.v; }
    }
    IC a = new IC();
    print(a.getv());
}

number i = 0;
while (i < 3) {
    class WC { public number v = 7; }
    WC w = new WC();
    print(w.v);
    i = i + 1;
}

for (number k = 0; k < 2; k = k + 1) {
    class FC { public number v = 9; }
    FC f = new FC();
    print(f.v);
}

number n = 2;
switch (n) {
    1 {
        class SC1 { public number v = 5; }
        SC1 s1 = new SC1();
        print(s1.v);
    }
    2 {
        class SC2 { public number v = 11; }
        SC2 s2 = new SC2();
        print(s2.v);
    }
}
print("END");
