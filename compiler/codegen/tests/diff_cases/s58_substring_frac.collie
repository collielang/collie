// t105 S58 差分用例：subString 非整数参数解锁——Double/Num 参数对齐
// 解释器语义：end 在 floor 前判 NaN/精确 -1.0 取 length（floor(-0.9) 为
// -1 不特判、clamp 到 0 得空串，顺序敏感）；NaN start 归 0；其余 floor
// 后 clamp 交 rt 垫片按 length 收口；Int 路径既有语义不变

string s = "hello world";            // 11 码点
print(s.subString(1.5));             // floor 1 -> ello world
print(s.subString(0, 4.9));          // end floor 4 -> hell
print(s.subString(-0.5));            // floor -1 clamp 0 -> hello world
print("[" + s.subString(0, -0.9) + "]");  // 非精确 -1.0：floor -1 clamp 0 -> []
print(s.subString(0, -1.0));         // 精确 -1.0（floor 前判）-> length -> hello world
print(s.subString(NaN));             // NaN start -> 0 -> hello world
print(s.subString(2, NaN));          // NaN end -> length -> llo world
print(s.subString(0, Infinity));     // clamp length -> hello world
print("[" + s.subString(Infinity) + "]"); // start clamp length -> []

// number（Num tagged 双表示）变量参数：整值/小数值两种 tag 路径
number n = 3.7;
print(s.subString(n));               // 小数 tag floor 3 -> lo world
print(s.subString(0, n));            // -> hel
number m = 2;
print(s.subString(m));               // 整数 tag -> llo world
print(s.subString(m, 9.5));          // 混合 Num 整数 + Double -> llo wor

// Int 既有路径不受影响
print(s.subString(2, -1));           // Int -1 -> length -> llo world
print(s.subString(6));               // world

// UTF-8 码点计数与非整数参数叠加
string cn = "牧羊犬语言";
print(cn.subString(1.2, 3.9));       // 码点 [1,3) -> 羊犬
print(cn.subString(2.5));            // 码点 [2,5) -> 犬语言
print("END");
