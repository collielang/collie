// t160 S107 差分用例：实例与嵌套数组混排字面量进 kind 7（tag 5/tag 4）后的
// 显示、长度、索引读、嵌套索引、实例位字段/方法与相等消费面
class Dog {
    public string name = "rex";
    public function speak() string {
        return "woof";
    }
}
Dog d = new Dog();
array a = [d, [1, 2]];
print("1", a);
print("2", len(a), a.length);
print("3", a[0]);
print("4", a[1], a[1][0], a[1][1], a[1].length);
print("5", a[0].name, a[0].speak());
object o = a[0];
print("6", o, o.name);
print("7", @"interp: {a}");
array b = [d, [1, 2]];
array c = [d, [1, 3]];
print("8", a == b, a == a, a == c);
array e = [1, [2, 3], "x", true];
print("9", e, e.length, e[1], e[1][1], e[2], e[3]);
