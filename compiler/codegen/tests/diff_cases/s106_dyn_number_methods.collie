// s106 差分用例：number 专属方法在动态承载值（Dyn）上按运行期 tag 分派
// 覆盖 ten 个方法（abs/integerPart/decimalPart/isInteger/isDecimal/isNaN/
// isInfinity/isFinite/isPositive/isNegative）与各路 Dyn 来源
function wide(a array) none {
    print("A:", a[0].abs(), "|", a[1].abs(), "|", a[0].integerPart(), "|", a[1].integerPart());
    print("B:", a[0].decimalPart(), "|", a[1].decimalPart(), "|", a[2].decimalPart());
    print("C:", a[0].isInteger(), "|", a[1].isInteger(), "|", a[0].isDecimal(), "|", a[1].isDecimal());
    print("D:", a[0].isNegative(), "|", a[1].isPositive(), "|", a[0].isNaN(), "|", a[1].isFinite(), "|", a[2].isInfinity());
    integer i = a[0].integerPart();
    print("E:", i, "|", a[0].abs() + 1, "|", a[1].abs() == 5.5, "|", @"{a[0].abs()}");
    number n = a[1].abs();
    print("F:", n * 2);
}
function hetero(a array) none {
    array tmp = [-9, -9.25, 3, true, "x"];
    print("G:", tmp[0].abs(), "|", tmp[1].abs(), "|", tmp[2].integerPart(), "|", tmp[0].isNegative());
    print("H:", tmp[1].isInteger(), "|", tmp[1].isDecimal(), "|", tmp[2].isFinite());
}
function carriers(a array) none {
    object v = a[0];
    print("I:", v.abs(), "|", v.isNegative());
    v = a[1];
    print("J:", v.abs(), "|", v.integerPart());
    Tuple tup = (a[0], a[1]);
    integer i = 1;
    print("K:", tup[i].abs());
    Tuple u = (x: a[0], y: a[1]);
    print("L:", u.get("x").abs(), "|", u.get("y").isDecimal());
    array mix = [a[0], "s", a[1]];
    print("M:", mix[0].abs(), "|", mix[2].integerPart());
    for (integer k = 0; k < 2; k = k + 1) {
        print("N:", a[k].abs());
    }
}
function nested(a array) none {
    print("O:", a[0][0].abs(), "|", a[0][1].isInteger());
}
function closure(a array) none {
    object v = a[1];
    function reader() none { print("P:", v.abs(), "|", v.decimalPart()); }
    reader();
}
class Box {
    public array vals = [-4, -4.5];
    public function show() none { print("Q:", this.vals[0].abs(), "|", this.vals[1].isInteger()); }
}
function specials(a array) none {
    print("R:", a[0].isNaN(), "|", a[0].isFinite(), "|", a[0].isInteger(), "|", a[0].isPositive());
    print("S:", a[1].isInfinity(), "|", a[1].isFinite(), "|", a[1].isNegative(), "|", a[1].abs());
    print("T:", a[0].integerPart(), "|", a[1].integerPart(), "|", a[1].decimalPart());
}
wide([-5, -5.5, 7, true]);
hetero(["x"]);
carriers([-1, -1.5, 2]);
nested([[-7, 8], [9, 10]]);
closure([-2, -2.5]);
Box b = new Box();
b.show();
number nan = "abc".toNumber();
number inf = "+Infinity".toNumber();
specials([nan, inf]);
