// 嵌套数组（t85）：字面量/print/逐层索引读写/负索引/别名引用联动/
// 整槽替换/内层混合提升/深比较/length/len/toString
array m = [[1, 2], [3, 4]];
print(m);
print(m[1]);
print(m[1][0]);
print(m[-1][-1]);
m[0][1] = 9;
print(m);
array row = m[0];
row[0] = 7;
print(m);
m[1] = [5, 6];
print(m);
print(m.length, len(m), m[0].length);
array d = [[1.5, 2], [3, 4.5]];
print(d);
d[0][1] = 8;
print(d[0]);
array a = [[1, 2], [3, 4]];
array b = [[1, 2], [3, 4]];
print(a == b, a != b);
b[1][1] = 0;
print(a == b);
print(toString(m));
