// t171 S118 差分用例：函数位 tag 9 进数组（字面量 / 元素写 / 读出 / 深比较 / 转串）
// 第一节为退役锁 s93_reject_function_in_array 的原程序
function add(a integer) integer {
    return a + 1;
}

function hi() none {
    print("called");
}

array fs = [add];
print("1", fs);

// 混合字面量：函数位与数值、串、数组、实例位共存在 kind 7 双步长槽
class Dog {
    public string name = "rex";
}
Dog d = new Dog();
array bag = [add, 1, "x", d, [2, 3]];
print("2", bag);
print("3", bag.length);
object head = bag[0];
print("4", head);
print("5", head.toString());
print("6", bag[1]);
print("7", bag[3]);
print("8", bag[4]);

// 元素写：静态数组位与函数位互换
array mix = [1, "x"];
mix[0] = add;
print("9", mix);
mix[1] = hi;
print("10", mix);
print("11", mix[0] == mix[1]);

// 深比较：含函数位的数组逐元素归一化后判等（函数位恒不等）
array q1 = [add, 7];
array q2 = [add, 7];
print("12", q1 == q2);
array q3 = [1, 2];
print("13", q3 == [1, 2]);

// 数组位嵌 tuple：tuple 进数组需静态承载位，改测数组位里的函数位经形参消费
function count(a array) integer {
    return a.length;
}
print("14", count([add, hi, 3]));

// 循环里换形状写入（接收者须为 kind 7 异质数组，数值系同质数组不可运行期加宽）
array slots = [0, "s", 0];
for (integer i = 0; i < 3; i += 1) {
    slots[i] = add;
}
print("15", slots);
print("16", slots[2]);

// 嵌套数组的函数位读出后转串
array outer = [[add, 1], 9];
print("17", outer);
array inner = outer[0];
print("18", inner);
print("19", inner[0]);
