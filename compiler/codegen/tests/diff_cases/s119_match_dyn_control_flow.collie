// t169 S116 差分用例：动态承载 `==?` 比较结果进控制流、三目臂与异质数组字面量
array src = [1, "x", true, [1, 2]];
object e = src[0];
string label = e ==? 1: "one", "no";
if (label == "one") {
    print("1 if-hit");
}
bool gate = e ==? "x": true, false;
print("2", gate);
object other = src[1];
print("3", other ==? "x": "ex", "no");
integer score = 0;
for (integer i = 0; i < 4; i = i + 1) {
    object item = src[i];
    score = score + (item ==? 1: 3, "x": 5, true: 7, [1, 2]: 11, 0);
    print("4", i, score, item ==? 1: "one", "x": "ex", true: "yes", [1, 2]: "arr", "none");
}
object fromTernary = gate ? src[2] : src[3];
print("5", fromTernary ==? true: "yes", [1, 2]: "arr", "no");
string composed = (fromTernary ==? true: "bool-bit", "other-bit") + "/" + label;
print("6", composed);
integer m1 = e ==? 1: 100, 0;
string m2 = other ==? "x": "X", "y";
array bag = [m1, m2, 7, [1, 2]];
print("7", bag);
print("8", bag[0], bag[1], bag[2], bag[3]);
object nested = bag[3];
print("9", nested ==? [1, 2]: "inner-arr", "no");
tribool tb = unset;
object tbo = tb;
print("10", tbo ==? unset: "u", true: "t", false: "f", "x");
