// t159 S106 差分用例：数值系混排字面量按元素保型（kind 7）后的消费面
array a = [3, 4.5];
print("1", a);
integer i = a[0];
decimal d = a[1];
number n = a[0];
string s = a[0];
print("2", i + 1, d + 1, n, s + "!");
print("3", a[0].isInteger(), a[0].isDecimal(), a[1].isInteger());
print("4", a[0].integerPart(), a[1].decimalPart(), a[0].abs());
print("5", a[0].toNumber() + 1);
print("6", a[0] + a[1], a[1] - a[0], a[0] * 2, a[1] / 2, a[1] % 2);
print("7", a[0] < a[1], a[1] > 4, a[0] == a[0]);
print("8", @"{a[0]}|{a[1]}|{s}");
print("9", len(a), a.length);
a[0] = 7;
print("10", a, a[0].isInteger());
a[1] = 8;
print("11", a[1].toNumber());
array m = [1, "x", 2.5, true, unset];
print("12", m, m[1].length, m[3].toString(), m[4].toString());
m[2] = 9;
print("13", m[2].isInteger(), m);
array idx = [2, 1.5];
array src = [9, 8, 7];
integer k = idx[0];
print("14", src[k]);
