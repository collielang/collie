// t160 S107 差分用例：kind 7 数组元素写侧（写入值为数组）与后续读取显示
array a = [1, "x"];
print("1", a);
a[0] = [7, 8];
print("2", a, a[0], a[0][1], a[0].length);
a[1] = [true, unset];
print("3", a, a[1], a[1][0], a[1][1]);
array m = [1, [2, 3], "x", true];
print("4", m, m.length, m[1], m[1][1]);
m[2] = [[4], [5]];
print("5", m, m[2], m[2][0], m[2][0][0]);
integer i = 0;
print("6", m[i], m[1][i]);
m[3] = [1, 2];
print("7", m, m[3].length);
