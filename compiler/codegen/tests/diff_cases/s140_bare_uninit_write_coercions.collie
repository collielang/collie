// t190 S137 差分用例：裸值槽写侧转换面——integer→decimal、bool→tribool、
// number 重赋、byte/word 边界值、char/character 字面量，以及 object 动态值
// 写入裸值槽后按声明型消费
decimal d;
d = 3;
print("1", d, d + 0.5);
tribool t;
t = true;
print("2", t, t.isFalse());
string s;
s = 42;
print("3", s, s.length);
s = true;
print("4", s);
number n;
n = 3;
n = 4.5;
print("5", n, n + 1);
integer i;
i = 10;
print("6", i / 4, i % 4);
byte b;
b = 255;
print("7", b);
word w;
w = 65535;
print("8", w);
char c;
c = 'a';
print("9", c);
character ch;
ch = '好';
print("10", ch);
object o = 5;
number from_dyn;
from_dyn = o;
print("11", from_dyn + 1);
object s2 = "hey";
string from_str;
from_str = s2;
print("12", from_str, from_str.length);
object t2 = true;
bool from_bool;
from_bool = t2;
print("13", from_bool, !from_bool);
object t3 = unset;
tribool from_tri;
from_tri = t3;
print("14", from_tri, from_tri.isUnset());
