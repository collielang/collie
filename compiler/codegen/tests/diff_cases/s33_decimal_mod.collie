// s33: decimal 取模（t80）——floor 语义（符号随除数）、混合类型、除零 NaN、
// Infinity 边界、%= 复合赋值、跨签名与数组元素参与、number 路径回归保护
decimal a = 7.5;
decimal b = 2.0;
print(a % b);           // 1.5
print(7.5 % 2.5);       // 0（精确整除）
print(-7.5 % 2.0);      // 0.5（floor：结果符号随除数）
print(7.5 % -2.0);      // -0.5
print(-7.5 % -2.0);     // -1.5
print(7 % 2.5);         // 2（Int × Double 混合）
print(7.5 % 2);         // 1.5（Double × Int 混合）
print(-5.0 % 2.5);      // 0（-0.0 归一格式化）
print(0.0 % 2.5);       // 0

// 除零与特殊数值（IEEE 754 对齐）
print(7.5 % 0.0);       // NaN
print(-7.5 % 0.0);      // NaN
print(7.5 % Infinity);  // 7.5
print(-7.5 % Infinity); // +Infinity（floor 修正：-7.5 + Infinity）
print(Infinity % 2.5);  // NaN
print(NaN % 2.5);       // NaN

// %= 复合赋值
decimal c = 10.75;
c %= 3.0;
print(c);               // 1.75
c %= -1.0;
print(c);               // -0.25

// 表达式嵌套与比较参与
print((9.5 % 3.0) + 0.5);        // 1
print(5.5 % 2.0 == 1.5);         // true

// 跨函数签名（decimal 形参/返回值）
function fmod2(x decimal, y decimal) decimal {
    return x % y;
}
print(fmod2(9.9, 3.3));          // 8.88178e-16（浮点残差，两端同 IEEE 运算一致）
print(fmod2(-1.0, 5.0));         // 4

// 循环内累积
decimal acc = 0.0;
for (integer i = 1; i <= 4; i = i + 1) {
    acc = acc + (7.5 % (i + 0.5));
}
print(acc);                      // 0+0+0.5+3 = 3.5

// 数组元素参与（double 数组索引读出）
array ds = [5.5, -5.5];
print(ds[0] % 3.0);              // 2.5
print(ds[1] % 3.0);              // 0.5

// number 路径回归保护（t62 既有 rt 下沉，Num × Double 混合）
number n = 7.5;
print(n % 2.0);                  // 1.5
number m = 7;
print(m % 2.5);                  // 2
