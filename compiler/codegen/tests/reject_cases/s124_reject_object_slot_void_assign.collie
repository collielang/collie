// t174 S121 拒编用例：实例初值的 object 槽重赋 Void（`none`）维持拒编——换表示
// 后该槽与无初值槽同为 CGType::Dyn，`none` 无编码故落 visitAssign Dyn 分支的
// is_dyn_carrier 守卫 "assigning incompatible value to 'o'"（解释器可直存并打印，
// 属活跃差分；原 s96_reject_obj_slot_scalar_reassign 的标量重赋面本批真实解锁，
// 其程序保留在差分用例 s124_object_slot_carrier_cycle 第一节）
class Dog {
    public string name = "rex";
    public function sound() string { return "woof"; }
}
function nop() none { }

object o = new Dog();
print(o.sound());
o = nop();
print(o);
print("END");
