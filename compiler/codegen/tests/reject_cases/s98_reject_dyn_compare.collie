// t148 S95 拒编用例：kind 7 元素读出（Dyn）参与比较运算
// 解释器 eval_comparison 对 int/decimal 走数值视图、字符串位走字典序，故
// a[0] < a[1] / a[2] < "y" 可运行；codegen 比较面仍要求双侧有静态数值或
// 字符串表示，Dyn 落 "non-numeric operand of '<'" 拒编不错编
// （运行期 tag 分派的比较面是后续任务，本用例锁住保守面）
array a = [7, 2.5, "x"];
integer i = 0;
print("lt:", a[0] < a[1]);
print("le:", a[1] <= 2.5);
print("gt:", a[i] > 3);
print("str:", a[2] < "y");
