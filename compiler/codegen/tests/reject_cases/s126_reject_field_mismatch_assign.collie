// t176 S123 拒编锁：跨类同名但声明类型不一致的字段**写**侧维持保守拒编
// 解释器 visitPropertyAssign 按动态类的字段声明 coerce 后直存（o 持 Cat 时
// `o.name = 9` 得 9）；codegen 的多类树写路径只有一份 switch 前的
// coerce_for_slot/check_bit_range，逐臂各自声明类型的写入与赋值表达式返回值
// 均不可静态统一，故本批只切读侧、写侧仍拒编不错编
class Dog { public string name = "rex"; }
class Cat { public integer name = 42; }

Cat c = new Cat();
object o = c;
o.name = 9;
print("1", o.name);
