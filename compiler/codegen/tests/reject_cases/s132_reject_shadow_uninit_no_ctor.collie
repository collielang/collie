// t182 S129 拒编锁 4：子类以**无初值**字段遮蔽父类有初值字段，且本类构造器不定赋
// 合并后该槽最终声明无初值，解释器把同名键绑回 none 并可被观察（print 打 none，
// rc=0）；codegen 的 none 无静态字段表示，走 t109/t126 既有守卫——构造器前缀未
// 定赋即保守拒编（同族放行面见差分用例 s132_shadow_ctor 的 Leaf8）
class AnimalR4 { public string tag = "animal"; }
class DogR4 extends AnimalR4 { public string tag; }
object o = new DogR4();
print("1", o.tag);
AnimalR4 a = new DogR4();
print("2", a.tag);
