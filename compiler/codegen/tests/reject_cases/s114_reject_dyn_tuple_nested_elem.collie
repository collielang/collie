// t164 S111 拒编锁：动态 tuple 的嵌套 tuple 元素（kind 空间无 tuple 承载位）
// 解释器 (n: (q: 1), z: "x") 合流后可直接打印与取用；codegen 的 {tag,bits} 承载
// tag 只到 0-7（无 tuple 位），物化处保守拒编不错编——需另设运行期 tuple tag 方为差分面
function inner(flag bool) Tuple {
    return flag ? (q: 1) : (r: "s");
}
function mk(flag bool) Tuple {
    return flag ? (n: inner(true), a: [1, 2]) : (z: "x");
}
Tuple t = mk(true);
print("1", t);
print("2", t.n);
